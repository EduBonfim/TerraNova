{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "preview-ios": {
      "ios": {
        "buildType": "simulator"
      },
      "distribution": "internal",
      "channel": "preview-ios"
    },
    "preview-android": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "channel": "preview-android"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
